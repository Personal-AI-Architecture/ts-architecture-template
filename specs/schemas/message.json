{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-template/specs/schemas/message.json",
  "title": "Message",
  "type": "object",
  "required": ["role", "content"],
  "properties": {
    "role": {
      "type": "string",
      "enum": ["system", "user", "assistant", "tool"]
    },
    "content": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/toolCall"
      }
    },
    "tool_call_id": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "tool"
          }
        },
        "required": ["role"]
      },
      "then": {
        "required": ["tool_call_id"]
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "toolCall": {
      "type": "object",
      "required": ["id", "type", "function"],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "function"
        },
        "function": {
          "type": "object",
          "required": ["name", "arguments"],
          "properties": {
            "name": {
              "type": "string"
            },
            "arguments": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
